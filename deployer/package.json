    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "esbuild": "^0.25.0",
    "hono": "^4.9.10"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "@types/node": "^24.0.0"
  }
}
