{
  "name": "mailedge-deployer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MailEdge 网页安装向导：用户提供一次性 Cloudflare API Token，自动建资源并部署 MailEdge",
  "scripts": {
    "dev": "tsx watch src/index.ts",
