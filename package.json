{
  "name": "mailedge",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite build --watch",
    "dev:worker": "wrangler dev",
    "build:web": "vite build",
    "build": "npm run build:web && tsc --noEmit -p tsconfig.worker.json",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "deploy": "npm run build:web && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply mailedge --local",
    "db:migrate": "wrangler d1 migrations apply mailedge --remote"
  },
  "dependencies": {
    "@fontsource-variable/stack-sans-notch": "^5.3.0",
    "@passwordless-id/webauthn": "^2.4.0",
    "chart.js": "^4.5.1",
    "hono": "^4.9.10",
    "lucide-react": "^0.545.0",
    "postal-mime": "^2.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
