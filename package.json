{
  "name": "mailedge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite build --watch",
    "dev:worker": "wrangler dev",
    "build:web": "vite build",
    "build": "npm run build:web && tsc --noEmit -p tsconfig.worker.json",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.web.json",
    "deploy": "npm run build:web && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply mailedge --local",
    "db:migrate": "wrangler d1 migrations apply mailedge --remote"
  },
  "dependencies": {
    "hono": "^4.9.10",
    "lucide-react": "^0.545.0",
    "postal-mime": "^2.4.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^7.0.2",
    "vite": "^7.1.9",
    "wrangler": "^4.115.0"
  }
}
