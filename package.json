{
  "name": "mailedge",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite build --watch",
    "dev:worker": "wrangler dev",
    "build:web": "vite build",
    "build": "npm run build:web && tsc --noEmit -p tsconfig.worker.json",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:state:reset": "node scripts/prepare-e2e-state.mjs",
    "e2e:db:migrate": "wrangler d1 migrations apply mailedge --local --persist-to .wrangler/e2e",
    "e2e:server": "npm run e2e:state:reset && npm run build:web && npm run e2e:db:migrate && wrangler dev --ip 127.0.0.1 --port 8790 --persist-to .wrangler/e2e --show-interactive-dev-session false",
    "qa:fixtures:check": "python3 scripts/seed-local-mail.py --dry-run",
    "qa:fixtures:test": "python3 -m unittest discover -s test -p 'seed_local_mail_test.py'",
    "qa:fixtures:seed:local": "npm run qa:fixtures:check && python3 scripts/seed-local-mail.py",
    "qa:migrations:test": "python3 test/migrations_test.py",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run qa:migrations:test",
    "deploy": "npm run build:web && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply mailedge --local",
    "db:migrate": "wrangler d1 migrations apply mailedge --remote"
  },
  "dependencies": {
    "@fontsource-variable/stack-sans-notch": "^5.3.0",
    "@passwordless-id/webauthn": "^2.4.0",
    "chart.js": "^4.5.1",
    "hono": "^4.13.1",
    "lucide-react": "^0.545.0",
    "postal-mime": "^2.7.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.7",
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
