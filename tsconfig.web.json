{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "composite": true
  },
  "include": ["web/src/**/*.ts", "web/src/**/*.tsx", "src/mail/types.ts", "src/ai/types.ts", "src/shared/**/*.ts"]
}
